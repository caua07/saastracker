{
  "name": "saastemics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:neon": "tsx scripts/verify-neon.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json *.md docs/design/*.md",
    "format:check": "prettier --check src scripts tests *.ts *.mjs *.json *.md docs/design/*.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@fontsource-variable/manrope": "^5.3.0",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@vercel/functions": "3.6.1",
    "better-auth": "^1.7.14",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "simple-icons": "^16.36.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
